# AegisCode AI — environment template (placeholders only — never real secrets).
# Copy to `.env` (git-ignored) or export in your shell before starting the server.
# NEVER commit a filled-in copy.

# Server access tokens (required): comma-separated, e.g. "tok1,tok2".
AEGISCODE_API_TOKENS="dev-token-PLACEHOLDER"

# --- Meta Model API advisory (optional; offline mock is the default) ---
# Default is META_MODE=mock: no network, no spend, marked mock output.
META_MODE="mock"
# To enable live calls (ONLY on the server machine, never in the browser):
#   META_MODE="live"
#   META_API_KEY="PASTE_YOUR_KEY_IN_SECRETS_SETTINGS_NOT_HERE"
# Model and endpoint overrides (defaults already match the verified setup):
#   META_MODEL_ID="muse-spark-1.3"
#   META_BASE_URL="https://api.meta.ai/v1"

# Server options
# PORT default 8080; DATA_DIR default ./data
# PORT="8080"
# DATA_DIR="./data"
